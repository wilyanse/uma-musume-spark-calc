      </group>
      <group targetFramework="net6.0-windows7.0">
        <dependency id="SQLitePCLRaw.core" version="2.1.12" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="SQLitePCLRaw.core" version="2.1.12" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>
