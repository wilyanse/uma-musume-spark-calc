{
  // Worker "uma-spark-calc" (docs/specs/65-devops.md §2). Real resource ids are filled in by T12/H2.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uma-spark-calc",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uma-spark-calc",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "CROPS", "bucket_name": "uma-spark-calc-crops" }],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "MASTER_VERSION": "unversioned",
  },
  // ACCESS_AUD is a secret; AUTH_DISABLED lives only in .dev.vars (65 §3). No env.production
  // block defines AUTH_DISABLED (T04 adds the startup assertion).
}
