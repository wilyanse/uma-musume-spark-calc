{
  // Worker "uma-spark-calc" (docs/specs/65-devops.md §2). Real resource ids are filled in by T12/H2.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uma-spark-calc",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uma-spark-calc",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "CROPS", "bucket_name": "uma-spark-calc-crops" }],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "MASTER_VERSION": "unversioned",
  },
  // ACCESS_AUD is a secret; AUTH_DISABLED lives only in .dev.vars (65 §3).
  // Bindings and vars are repeated because Wrangler environments do not inherit them.
  // H2 must replace the placeholder database_id and set ACCESS_TEAM_DOMAIN before deploy.
  "env": {
    "production": {
      "name": "uma-spark-calc",
      "main": "src/index.ts",
      "compatibility_date": "2026-08-01",
      // Production is served only on uma-spark-calc.<subdomain>.workers.dev, which the hostname
      // Access app protects. Version/preview URLs are separate hostnames, so they stay off.
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "uma-spark-calc",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "CROPS", "bucket_name": "uma-spark-calc-crops" }],
      // MASTER_VERSION must equal apps/web/public/master/latest.json "version" (CI enforces it).
      "vars": {
        "ACCESS_TEAM_DOMAIN": "",
        "MASTER_VERSION": "global-20260930",
      },
    },
  },
}
