<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-independent T10 shell logic (agent/src/Uma.Agent.Windows/Portable/**) compiled for net8.0 and run on macOS
       against the real Uma.Agent.Core, the 15 screenshot fixtures and recorded OCR (all read-only). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../src/Uma.Agent.Windows/Portable/**/*.cs" Link="Shell/%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="../../../src/Uma.Agent.Core/Uma.Agent.Core.csproj" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
