{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "character",
          "outfit",
          "skill",
          "spark",
          "scenario",
          "epithet"
        ]
      },
      "id": {
        "type": "string",
        "pattern": "^[a-z]+:[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "text": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "kind",
      "id",
      "text"
    ],
    "additionalProperties": false
  }
}
