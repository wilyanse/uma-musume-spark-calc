{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "veteranId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "path": {
      "type": "string",
      "pattern": "^(\\/[^/]+)+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved",
        "dismissed"
      ]
    },
    "resolvedValue": {},
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "resolvedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "field": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(\\/[^/]+)+$"
        },
        "rawText": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {},
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "low_confidence",
            "corrected"
          ]
        },
        "candidates": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {},
              "score": {
                "type": "number"
              }
            },
            "required": [
              "value",
              "score"
            ],
            "additionalProperties": false
          }
        },
        "cropKey": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "rawText",
        "value",
        "confidence",
        "status",
        "candidates",
        "cropKey"
      ],
      "additionalProperties": false
    },
    "cropKey": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "veteranId",
    "path",
    "status",
    "resolvedValue",
    "createdAt",
    "resolvedAt",
    "field",
    "cropKey"
  ],
  "additionalProperties": false
}
