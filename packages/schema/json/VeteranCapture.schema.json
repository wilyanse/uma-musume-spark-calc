{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "captureId": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "agentVersion": {
      "type": "string",
      "minLength": 1
    },
    "layoutVersion": {
      "type": "string",
      "minLength": 1
    },
    "masterVersion": {
      "type": "string",
      "minLength": 1
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "veteran": {
      "type": "object",
      "properties": {
        "characterId": {
          "type": "string",
          "pattern": "^character:[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "outfitId": {
          "type": "string",
          "pattern": "^outfit:[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "rank": {
          "type": "string",
          "minLength": 1
        },
        "rating": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "epithet": {
          "type": "string"
        },
        "trainMode": {
          "type": "string",
          "enum": [
            "independent",
            "manual"
          ]
        },
        "stats": {
          "type": "object",
          "properties": {
            "spd": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "sta": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "pow": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "gut": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "wit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            }
          },
          "required": [
            "spd",
            "sta",
            "pow",
            "gut",
            "wit"
          ],
          "additionalProperties": false
        },
        "aptitudes": {
          "type": "object",
          "properties": {
            "turf": {
              "type": "string",
              "enum": [
                "G",
                "F",
                "E",
                "D",
                "C",
                "B",
                "A",
                "S"
              ]
            },
            "dirt": {
              "type": "string",
              "enum": [
                "G",
                "F",
                "E",
                "D",
                "C",
                "B",
                "A",
                "S"
              ]
            },
            "sprint": {
              "type": "string",
              "enum": [
                "G",
                "F",
                "E",
                "D",
                "C",
                "B",
                "A",
                "S"
              ]
            },
            "mile": {
              "type": "string",
              "enum": [
                "G",
                "F",
                "E",
                "D",
                "C",
                "B",
                "A",
                "S"
              ]
            },
            "medium": {
              "type": "string",
              "enum": [
                "G",
                "F",
                "E",
                "D",
                "C",
                "B",
                "A",
                "S"
              ]
            },
            "long": {
              "type": "string",
              "enum": [
                "G",
                "F",
                "E",
                "D",
                "C",
                "B",
                "A",
                "S"
              ]
            },
            "front": {
              "type": "string",
              "enum": [
                "G",
                "F",
                "E",
                "D",
                "C",
                "B",
                "A",
                "S"
              ]
            },
            "pace": {
              "type": "string",
              "enum": [
                "G",
                "F",
                "E",
                "D",
                "C",
                "B",
                "A",
                "S"
              ]
            },
            "late": {
              "type": "string",
              "enum": [
                "G",
                "F",
                "E",
                "D",
                "C",
                "B",
                "A",
                "S"
              ]
            },
            "end": {
              "type": "string",
              "enum": [
                "G",
                "F",
                "E",
                "D",
                "C",
                "B",
                "A",
                "S"
              ]
            }
          },
          "required": [
            "turf",
            "dirt",
            "sprint",
            "mile",
            "medium",
            "long",
            "front",
            "pace",
            "late",
            "end"
          ],
          "additionalProperties": false
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "skillId": {
                "type": "string",
                "pattern": "^skill:[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "level": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "skillId",
              "level"
            ],
            "additionalProperties": false
          }
        },
        "sparks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "owner": {
                "type": "string",
                "enum": [
                  "self",
                  "parent1",
                  "parent2"
                ]
              },
              "sparkId": {
                "type": "string",
                "pattern": "^spark:[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "blue",
                  "pink",
                  "green",
                  "white"
                ]
              },
              "stars": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 1
                  },
                  {
                    "type": "number",
                    "const": 2
                  },
                  {
                    "type": "number",
                    "const": 3
                  }
                ]
              }
            },
            "required": [
              "owner",
              "sparkId",
              "type",
              "stars"
            ],
            "additionalProperties": false
          }
        },
        "deck": {
          "minItems": 6,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "cardId": {
                "type": "string",
                "pattern": "^card:[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "lb": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "borrowed": {
                "type": "boolean"
              }
            },
            "required": [
              "slot",
              "cardId",
              "lb",
              "level",
              "borrowed"
            ],
            "additionalProperties": false
          }
        },
        "parents": {
          "minItems": 2,
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 1
                  },
                  {
                    "type": "number",
                    "const": 2
                  }
                ]
              },
              "characterId": {
                "type": "string",
                "pattern": "^character:[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "outfitId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^outfit:[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "isGuest": {
                "type": "boolean"
              },
              "guestTrainer": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "slot",
              "characterId",
              "outfitId",
              "isGuest",
              "guestTrainer"
            ],
            "additionalProperties": false
          }
        },
        "scenarioId": {
          "type": "string",
          "pattern": "^scenario:[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "career": {
          "type": "object",
          "properties": {
            "races": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "wins": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "fans": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "dateAcquired": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            }
          },
          "required": [
            "races",
            "wins",
            "fans",
            "dateAcquired"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "characterId",
        "outfitId",
        "rank",
        "rating",
        "epithet",
        "trainMode",
        "stats",
        "aptitudes",
        "skills",
        "sparks",
        "deck",
        "parents",
        "scenarioId",
        "career"
      ],
      "additionalProperties": false
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(\\/[^/]+)+$"
          },
          "rawText": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {},
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "low_confidence",
              "corrected"
            ]
          },
          "candidates": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {},
                "score": {
                  "type": "number"
                }
              },
              "required": [
                "value",
                "score"
              ],
              "additionalProperties": false
            }
          },
          "cropKey": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "path",
          "rawText",
          "value",
          "confidence",
          "status",
          "candidates",
          "cropKey"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "captureId",
    "capturedAt",
    "agentVersion",
    "layoutVersion",
    "masterVersion",
    "fingerprint",
    "veteran",
    "fields"
  ],
  "additionalProperties": false
}
