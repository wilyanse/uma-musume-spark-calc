{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "masterVersion": {
      "type": "string",
      "minLength": 1
    },
    "heldCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cardId": {
            "type": "string",
            "pattern": "^card:[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "lb": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "cardId",
          "lb",
          "level",
          "confidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "capturedAt",
    "masterVersion",
    "heldCount",
    "cards"
  ],
  "additionalProperties": false
}
